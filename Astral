						elapsed += 0.05
					end

					if valid("VOID HIDE", token)
						and State.VoidHide.ReturnPosition
						and savedVoidPosition then

						if Character and Character.Parent then
							Character:PivotTo(savedVoidPosition)
						end
					end
				end)
			else
				local shouldReturn = State.VoidHide.ReturnPosition

				stopMovement()

				if shouldReturn
					and savedVoidPosition
					and Character
					and Character.Parent then

					Character:PivotTo(savedVoidPosition)
				end
			end
		end
	)

