RunService.RenderStepped:Connect(function(dt)
	for _, flake in ipairs(snowflakes) do
		local object = flake.Object

		if object.Parent then
			local camera = workspace.CurrentCamera

			if camera then
				local viewport = camera.ViewportSize

				local pos = object.Position

				local x = pos.X.Scale
				local y =
					pos.Y.Scale
					+ (
						flake.Speed
						* dt
						/ math.max(viewport.Y, 1)
					)

				local drift =
					flake.Drift
					* dt
					/ math.max(viewport.X, 1)

				x += drift

				if y > 1.05 then
					y = -0.05
					x = math.random()
				end

				if x > 1.05 then
					x = -0.05
				end

				if x < -0.05 then
					x = 1.05
				end

				object.Position = UDim2.new(
					x,
					0,
					y,
					0
				)
			end
		end
	end

	if FakeMarker and FakeMarker.Parent then
		updateFakeMarker()
	end

	local root = getRoot()

	if MonitorLabels.MODE then
		MonitorLabels.MODE.Text =
			State.ActiveMode or "IDLE"
	end

	if root then
		local p = root.Position
		local v = root.AssemblyLinearVelocity

		if MonitorLabels.POSITION then
			MonitorLabels.POSITION.Text = string.format(
				"X %.1f   Y %.1f   Z %.1f",
				p.X,
				p.Y,
				p.Z
			)
		end

		if MonitorLabels.VELOCITY then
			MonitorLabels.VELOCITY.Text = string.format(
				"X %.1f   Y %.1f   Z %.1f",
				v.X,
				v.Y,
				v.Z
			)
		end

		if MonitorLabels.HEALTH and Humanoid then
			MonitorLabels.HEALTH.Text = string.format(
				"%.0f / %.0f",
				Humanoid.Health,
				Humanoid.MaxHealth
			)
		end

		if MonitorLabels.STATE then
			MonitorLabels.STATE.Text =
				Humanoid
				and Humanoid:GetState().Name
				or "UNKNOWN"
		end
	end
end)

