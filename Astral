							break
						end

						local minD = math.min(
							State.Random.MinDistance,
							State.Random.MaxDistance
						)

						local maxD = math.max(
							State.Random.MinDistance,
							State.Random.MaxDistance
						)

						local distance =
							math.random() * (maxD - minD) + minD

						local angle =
							math.random() * math.pi * 2

						local horizontal = Vector3.new(
							math.cos(angle),
							0,
							math.sin(angle)
						)

						local vertical =
							(math.random() * 2 - 1)
							* State.Random.Vertical

						local destination =
							root.Position
							+ horizontal * distance
							+ Vector3.new(
								State.Random.X,
								State.Random.Y + vertical,
								State.Random.Z
							)

						moveCharacter(destination)

						task.wait(State.Random.Delay)
					end
				end)
			else
				stopMovement()
			end
		end
	)

