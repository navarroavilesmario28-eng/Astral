	local title = makeText(card, "DIRECTION", 13, true, C.Light)
	title.Position = UDim2.new(0, 13, 0, 7)
	title.Size = UDim2.new(1, -26, 0, 22)

	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Position = UDim2.new(0, 13, 0, 35)
	holder.Size = UDim2.new(1, -26, 0, 64)
	holder.Parent = card

	local grid = Instance.new("UIGridLayout")
	grid.CellPadding = UDim2.fromOffset(6, 6)
	grid.CellSize = UDim2.new(0.24, 0, 0, 28)
	grid.Parent = holder

	local names = {
		"Forward",
		"Backward",
		"Left",
		"Right",
		"Up",
		"Down"
	}

	for _, name in ipairs(names) do
		local b = makeButton(holder, name, 28)
		b.TextSize = 11

		local function update()
			if current == name then
				b.BackgroundColor3 = C.White
				b.TextColor3 = C.Black
			else
				b.BackgroundColor3 = C.Panel2
				b.TextColor3 = C.Light
			end
		end

		update()

		b.MouseButton1Click:Connect(function()
			current = name

			for _, other in ipairs(holder:GetChildren()) do
				if other:IsA("TextButton") then
					other.BackgroundColor3 = C.Panel2
					other.TextColor3 = C.Light
				end
			end

			b.BackgroundColor3 = C.White
			b.TextColor3 = C.Black

			callback(name)
		end)
	end

	return card
end

local function getRoot()
	if not Character or not Character.Parent then
		refreshCharacter()
	end

	if not Root or not Root.Parent then
		refreshCharacter()
	end

	return Root
end

local function stopMovement()
	State.Token += 1
	State.ActiveMode = nil
	HeaderStatus.Text = "● READY"
end

local function valid(mode, token)
	return State.ActiveMode == mode
		and State.Token == token
		and getRoot() ~= nil
end

local function moveCharacter(position, lookAt)
	local root = getRoot()

	if not root or not Character or not Character.Parent then
		return false
	end

	local cf

	if lookAt then
		local direction = lookAt - position

		if direction.Magnitude > 0.001 then
			cf = CFrame.lookAt(position, lookAt)
		else
			cf = root.CFrame.Rotation + position
		end
	else
		cf = root.CFrame - root.Position + position
	end

	Character:PivotTo(cf)
	return true
end

local function beginMode(mode, runner)
	stopMovement()

	State.Token += 1

	local token = State.Token
	State.ActiveMode = mode

	HeaderStatus.Text = "● " .. string.upper(mode)

	task.spawn(function()
		local ok, err = pcall(function()
			runner(token)
		end)

		if not ok then
			warn("[ASTRAL] " .. tostring(err))
		end

		if State.ActiveMode == mode and State.Token == token then
			stopMovement()
		end
	end)
end

local function directionVector(root, direction)
	if direction == "Forward" then
		return root.CFrame.LookVector
	elseif direction == "Backward" then
		return -root.CFrame.LookVector
	elseif direction == "Left" then
		return -root.CFrame.RightVector
	elseif direction == "Right" then
		return root.CFrame.RightVector
	elseif direction == "Up" then
		return Vector3.new(0, 1, 0)
	elseif direction == "Down" then
		return Vector3.new(0, -1, 0)
	end

	return root.CFrame.LookVector
end

local function buildNormal()
	clearPage()

	PageTitle.Text = "NORMAL"
	PageDescription.Text = "Fixed directional movement testing."

	section(
		"NORMAL MOVEMENT",
		"Move using one consistent direction with a configurable offset."
	)

	makeNumber(Scroll, "DISTANCE", State.Normal.Distance, 0, 10000, function(v)
		State.Normal.Distance = v
	end)

	makeNumber(Scroll, "VERTICAL", State.Normal.Vertical, -10000, 10000, function(v)
		State.Normal.Vertical = v
	end)

	makeNumber(Scroll, "X OFFSET", State.Normal.X, -10000, 10000, function(v)
		State.Normal.X = v
	end)

	makeNumber(Scroll, "Y OFFSET", State.Normal.Y, -10000, 10000, function(v)
		State.Normal.Y = v
	end)

	makeNumber(Scroll, "Z OFFSET", State.Normal.Z, -10000, 10000, function(v)
		State.Normal.Z = v
	end)

	makeNumber(Scroll, "DELAY", State.Normal.Delay, 0.01, 60, function(v)
		State.Normal.Delay = v
	end)

	directionButtons(
		Scroll,
		State.Normal.Direction,
		function(v)
			State.Normal.Direction = v
		end
	)

	local _, toggle = makeToggle(
		Scroll,
		"NORMAL",
		State.ActiveMode == "NORMAL",
		function(on)
			if on then
				beginMode("NORMAL", function(token)
					while valid("NORMAL", token) do
						local root = getRoot()
						if not root then
							break
						end

						local dir = directionVector(
							root,
							State.Normal.Direction
						)

						local destination =
							root.Position
							+ dir * State.Normal.Distance
							+ Vector3.new(
								State.Normal.X,
								State.Normal.Vertical + State.Normal.Y,
								State.Normal.Z
							)

						moveCharacter(destination)
						task.wait(State.Normal.Delay)
					end
				end)
			else
				stopMovement()
			end
		end
	)

	Controls.NORMAL = toggle
end

