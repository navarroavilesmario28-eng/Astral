local function directionButtons(parent, current, callback)
	local card = Instance.new("Frame")
	card.BackgroundColor3 = C.Panel
	card.BorderSizePixel = 0
	card.Size = UDim2.new(1, 0, 0, 112)
	card.Parent = parent

	corner(card, 8)
