local function makeNumber(parent, title, value, minValue, maxValue, callback)
	local holder = Instance.new("Frame")
	holder.BackgroundColor3 = C.Panel2
	holder.BorderSizePixel = 0
	holder.Size = UDim2.new(1, 0, 0, 62)
	holder.Parent = parent

	corner(holder, 7)
	stroke(holder, C.Border, 1, 0)

	local label = makeText(holder, title, 14, true, C.Light)
	label.Position = UDim2.new(0, 14, 0, 4)
	label.Size = UDim2.new(1, -125, 0, 26)

	local box = Instance.new("TextBox")
	box.BackgroundColor3 = C.Black
	box.BorderSizePixel = 0
	box.ClearTextOnFocus = false
	box.Text = tostring(value)
	box.TextColor3 = C.White
	box.TextSize = 14
	box.Font = Enum.Font.GothamMedium
	box.TextXAlignment = Enum.TextXAlignment.Center
	box.Size = UDim2.new(0, 92, 0, 38)
	box.Position = UDim2.new(1, -106, 0, 12)
	box.Parent = holder

	corner(box, 6)
	stroke(box, C.Border2, 1, 0)

	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)

		if not n then
			box.Text = tostring(value)
			return
		end

		n = math.clamp(n, minValue, maxValue)
		value = n
		box.Text = tostring(n)

		if callback then
			callback(n)
		end
	end)

	return holder, box
end

local function makeToggle(parent, title, initial, callback)
	local holder = Instance.new("Frame")
	holder.BackgroundColor3 = C.Panel2
	holder.BorderSizePixel = 0
	holder.Size = UDim2.new(1, 0, 0, 56)
	holder.Parent = parent

	corner(holder, 7)
	stroke(holder, C.Border, 1, 0)

	local label = makeText(holder, title, 14, true, C.Light)
	label.Position = UDim2.new(0, 14, 0, 0)
	label.Size = UDim2.new(1, -115, 1, 0)

	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.BackgroundColor3 = C.Black
	button.BorderSizePixel = 0
	button.Size = UDim2.new(0, 76, 0, 34)
	button.Position = UDim2.new(1, -90, 0, 11)
	button.Font = Enum.Font.GothamBold
	button.TextSize = 12
	button.Parent = holder

	corner(button, 6)
	stroke(button, C.Border2, 1, 0)

	local enabled = initial == true

	local function set(v)
		enabled = v
		button.Text = v and "ON" or "OFF"
		button.TextColor3 = v and C.Black or C.Gray
		button.BackgroundColor3 = v and C.White or C.Black
	end

	set(enabled)

	button.MouseButton1Click:Connect(function()
		enabled = not enabled
		set(enabled)

		if callback then
			callback(enabled)
		end
	end)

	return holder, {
		Set = set,
		Get = function()
			return enabled
		end
	}
end

